                            </h4>
                          </div>
                        </div>
                        <div class="form-float d-flex flex-column gap-1">
                          <div class="social-signup d-flex flex-row gap-3 mt-4">
                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/google.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Facebook Signup" />
                            </a>

                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/facebook.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Google Signup" />
                            </a>
                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/linkedin.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Google Signup" />
                            </a>
                          </div>

                          <div class="devider position-relative d-block">
                            <hr class="mb-4 mt-4" />
                            <div
                              class="position-absolute top-50 start-50 translate-middle">
                              <span
                                class="square--30 circle bg-white text-muted"
                                >OR</span
                              >
                            </div>
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Full Name</label
                            >
                            <input
                              type="text"
                              class="form-control"
                              placeholder="Enter your full name?" />
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Email ID<i class="text-danger text-md"
                                >*</i
                              ></label
                            >
                            <input
                              type="email"
                              class="form-control"
                              placeholder="Tell us your Email ID" />
                            <!-- <span class="text-sm opacity-75"
                            >We'll send relevant jobs and updates to this
                            email</span
                          >
						-->
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Organization Name<i class="text-danger text-md"
                                >*</i
                              ></label
                            >
                            <input
                              type="text"
                              class="form-control"
                              placeholder="Enter Organization Name" />
                          </div>

                          <label class="fw-medium fs-6 text-dark"
                            >Location<i class="text-danger text-md">*</i></label
                          >
                          <div class="nice-select form-control" tabindex="0">
                            <span class="current">Select Location</span>
                            <ul class="list">
                              <li data-value="1" class="option">Gurugram</li>
                              <li data-value="2" class="option">Ghaziabad</li>
                              <li data-value="3" class="option">Delhi</li>
                              <li data-value="4" class="option">Noida</li>
                              <li data-value="5" class="option">
                                Greater Noida
                              </li>
                              <li data-value="6" class="option">Faridabad</li>
                            </ul>
                          </div>

                          <div class="form-group mb-0">
                            <div class="form-check form-check-inline">
                              <input
                                class="form-check-input"
                                type="checkbox"
                                id="promotions"
                                value="option1" />
                              <label class="form-check-label" for="promotions"
                                >Send me important updates & promotions via SMS
                                & email</label
                              >
                            </div>
                          </div>

                          <div class="form-group mb-0">
                            <p class="confirmTex">
                              By clicking Register, you agree to the<a
                                href="#"
                                class="text-main">
                                Terms and Conditions
                              </a>
                              &amp;<a href="#" class="text-main">
                                Privacy Policy
                              </a>
                              of CNL Placement.
                            </p>
                            <button
                              type="submit"
                              class="btn btn-main full-width">
                              Register
                            </button>
                          </div>
                        </div>
                      </div>
                    </form>
                    <!-- ==== Employer Register Form End ==== -->
                    <!-- ==== Candidate Register Form Start ==== -->
                    <form
                      id="candidate-form"
                      method="post"
                      action="/candidate-dashboard"
                      class="p-md-4">
                      <div
                        id="form-candidate"
                        class="form-fade"
                        style="
                          background-color: white;
                          padding: 20px 50px 50px 50px;
                          border-radius: 10px;
                          margin-top: -70px;
                        ">
                        <!-- candidate form headings ==== -->
                        <div
                          class="d-flex align-items-center justify-content-start gap-3">
                          <div class="head-caps">
                            <h4>
                              <span style="font-weight: 100">Welcome</span
                              ><span
                                style="
                                  font-weight: 900;
                                  text-transform: uppercase;
                                  color: #ff3d00;
                                ">
                                Candidate</span
                              >
                              <span style="font-weight: 100"
                                >Register With</span
                              >
                            </h4>
                          </div>
                        </div>
                        <div class="form-float d-flex flex-column gap-1">
                          <div class="social-signup d-flex flex-row gap-3 mt-4">
                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/google.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Facebook Signup" />
                            </a>

                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/facebook.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Google Signup" />
                            </a>
                            <a
                              href="#"
                              class="btn btn-gray rounded-pill w-100 d-flex align-items-center justify-content-center">
                              <img
                                src="assets/img/linkedin.png"
                                class="img-fluid me-2"
                                width="30"
                                alt="Google Signup" />
                            </a>
                          </div>

                          <div class="devider position-relative d-block">
                            <hr class="mb-4 mt-4" />
                            <div
                              class="position-absolute top-50 start-50 translate-middle">
                              <span
                                class="square--30 circle bg-white text-muted"
                                >OR</span
                              >
                            </div>
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Full Name</label
                            >
                            <input
                              type="text"
                              class="form-control"
                              placeholder="Enter your full name?" />
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Email ID<i class="text-danger text-md"
                                >*</i
                              ></label
                            >
                            <input
                              type="email"
                              class="form-control"
                              placeholder="Tell us your Email ID" />
                            <!-- <span class="text-sm opacity-75"
                            >We'll send relevant jobs and updates to this
                            email</span
                          >
						-->
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Password<i class="text-danger text-md"
                                >*</i
                              ></label
                            >
                            <input
                              type="email"
                              class="form-control"
                              placeholder="(Minimum 8 characters)" />
                            <!-- <span class="text-sm opacity-75"
                            >This helps your account stay protected</span
                          >
						  -->
                          </div>

                          <div class="form-group mb-0">
                            <label class="fw-medium fs-6 text-dark"
                              >Mobile number<i class="text-danger text-md"
                                >*</i
                              ></label
                            >
                            <input
                              type="email"
                              class="form-control"
                              placeholder="Enter your mobile number" />
                            <!-- <span class="text-sm opacity-75"
                            >This helps your account stay protected</span
                          >
						  -->
                          </div>
                          <!--
						<div class="form-group mb-0">
                          <label class="fw-medium fs-6 text-dark"
                            >Organization Name<i class="text-danger text-md"
                              >*</i
                            ></label
                          >
                          <input
                            type="email"
                            class="form-control"
                            placeholder="Enter Organization Name"
                          />
                          <span class="text-sm opacity-75"
                            >This helps your account stay protected</span
                          >
                        </div>
						-->
                          <div class="form-group mb-0">
                            <div class="form-check form-check-inline">
                              <input
                                class="form-check-input"
                                type="checkbox"
                                id="promotions"
                                value="option1" />
                              <label class="form-check-label" for="promotions"
                                >Send me important updates & promotions via SMS
                                & email</label
                              >
                            </div>
                          </div>

                          <div class="form-group mb-0">
                            <p class="confirmTex">
                              By clicking Register, you agree to the<a
                                href="#"
                                class="text-main">
                                Terms and Conditions
                              </a>
                              &amp;<a href="#" class="text-main">
                                Privacy Policy
                              </a>
