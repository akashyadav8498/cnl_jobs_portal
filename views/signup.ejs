                          padding: 20px 50px 50px 50px;
                          border-radius: 10px;
                          margin-top: -40px;
                        ">
                        <!-- employer form headings ==== -->
                        <div
                          class="d-flex align-items-center justify-content-start gap-3">
                          <div class="head-caps">
                            <h4>
                              <span style="font-weight: 100">Welcome</span
                              ><span
                                style="
                                  font-weight: 900;
                                  text-transform: uppercase;
                                  color: #ff3d00;
                                ">
                                Employer</span
