  <script>
    jQuery(function ($) {
      const $roleBox = $("#role-select-box");
      const $emp = $("#form-employer");
      const $cand = $("#form-candidate");

      function hideAll() {
        $emp.removeClass("active");
        $cand.removeClass("active");
      }

      hideAll();

      $("input[name='role']").on("change", function () {
        let id = $(this).attr("id");

        $roleBox.addClass("fade-out");

        hideAll();

        if (id === "findtalent") {
          $emp.addClass("active");
        }

        if (id === "findjob") {
          $cand.addClass("active");
        }
      });
    });

    (function () {
      const form = document.getElementById("employer_form");
      const errorBox = document.getElementById("register-error");
      const submitButton = form.querySelector("button[type='submit']");

      // Modal elements
      const modalEl = document.getElementById("registerModal");
      const modalMessageEl = document.getElementById("registerModalMessage");
      const modalTimerEl = document.getElementById("registerModalTimer");
      const modalGoNowBtn = document.getElementById("registerModalGoNow");

      let countdownInterval = null;
      let redirectUrlGlobal = "/";

      form.addEventListener("submit", async function (e) {
        e.preventDefault(); // stop normal submit

        // clear old error
        errorBox.innerHTML = "";
        errorBox.className = "mt-3";

        submitButton.disabled = true;
        submitButton.textContent = "Registering...";

        try {
          const formData = new FormData(form);
          const obj = Object.fromEntries(formData.entries());

          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(obj),
          });

          const data = await response.json().catch(() => ({}));

          if (response.ok && data.status === "success") {
            // ✅ SUCCESS: show modal with timer
            const redirectUrl = data.redirectUrl || "/";
            redirectUrlGlobal = redirectUrl;

            // set message & initial timer
            modalMessageEl.textContent =
              data.message || "You have registered successfully.";
            let seconds = 10;
            modalTimerEl.textContent = seconds;

            // show Bootstrap modal
            const bsModal = new bootstrap.Modal(modalEl);
            bsModal.show();

            // clear any old interval
            if (countdownInterval) clearInterval(countdownInterval);

            countdownInterval = setInterval(function () {
              seconds--;
              if (seconds <= 0) {
                clearInterval(countdownInterval);
                window.location.href = redirectUrl;
              } else {
                modalTimerEl.textContent = seconds;
              }
            }, 1000);

            // optional: reset form fields
            // form.reset();
          } else {
            // ❌ FAILURE: show error under button, no redirect
            const errorMsg =
              (data && data.message) ||
              "Registration failed. Please check your details and try again.";

            errorBox.innerHTML = errorMsg;
            errorBox.classList.add("alert", "alert-danger");

            submitButton.disabled = false;
            submitButton.textContent = "Register";
          }
        } catch (err) {
          console.error("Request error:", err);
          errorBox.innerHTML =
            "An error occurred while submitting the form. Please try again.";
          errorBox.classList.add("alert", "alert-danger");

          submitButton.disabled = false;
          submitButton.textContent = "Register";
        }
      });

      // "Go Now" button in modal: redirect immediately
      modalGoNowBtn.addEventListener("click", function () {
        if (countdownInterval) clearInterval(countdownInterval);
        window.location.href = redirectUrlGlobal;
      });

      // If modal is closed manually, stop timer (optional)
      modalEl.addEventListener("hidden.bs.modal", function () {
        if (countdownInterval) clearInterval(countdownInterval);
        submitButton.disabled = false;
        submitButton.textContent = "Register";
      });
    })();
  </script>
</html>
