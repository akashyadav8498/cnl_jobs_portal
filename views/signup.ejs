<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CNL Placement</title>
    <link rel="icon" type="image/x-icon" href="assets/img/favicon.png" />

    <!-- Custom CSS -->
    <link href="assets/css/styles.css" rel="stylesheet" />

    <!-- Colors CSS -->
    <link href="assets/css/colors.css" rel="stylesheet" />
    <style>
      .form-fade {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateX(40px); /* start slightly from right */
        transition: opacity 0.45s ease, transform 0.45s ease,
          visibility 0.45s ease;
        height: 0;
        overflow: hidden;
      }

      .form-fade.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(0); /* slide to normal position */
        height: auto;
      }

      .form-fade.active {
        height: auto;
      }

      #role-select-box.fade-out {
        opacity: 0;
        visibility: hidden;
        height: 0;
        overflow: hidden;
        margin: 0;
        padding: 0;
        transition: opacity 0.4s ease, height 0.4s ease, padding 0.4s ease,
          margin 0.4s ease;
      }
      .nice-select .list {
        max-height: 150px;
        overflow-y: auto;
      }
    </style>
  </head>

