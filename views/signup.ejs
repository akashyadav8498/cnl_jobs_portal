<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CNL Placement</title>
    <link rel="icon" type="image/x-icon" href="assets/img/favicon.png" />

    <!-- Custom CSS -->
    <link href="assets/css/styles.css" rel="stylesheet" />

    <!-- Colors CSS -->
    <link href="assets/css/colors.css" rel="stylesheet" />
    <style>
      .form-fade {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateX(40px); /* start slightly from right */
        transition: opacity 0.45s ease, transform 0.45s ease,
          visibility 0.45s ease;
        height: 0;
        overflow: hidden;
      }

      .form-fade.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(0); /* slide to normal position */
        height: auto;
      }

      .form-fade.active {
        height: auto;
      }

      #role-select-box.fade-out {
        opacity: 0;
        visibility: hidden;
        height: 0;
        overflow: hidden;
        margin: 0;
        padding: 0;
        transition: opacity 0.4s ease, height 0.4s ease, padding 0.4s ease,
          margin 0.4s ease;
      }
      .nice-select .list {
        max-height: 150px;
        overflow-y: auto;
      }
    </style>
  </head>

  <body>
    <!-- ============================================================== -->
    <!-- Preloader - style you can find in spinners.css -->
    <!-- ============================================================== -->
    <div id="preloader">
      <div class="preloader"><span></span><span></span></div>
    </div>

    <!-- ============================================================== -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <div id="main-wrapper">
      <!-- ============================================================== -->
      <!-- Top header  -->
      <!-- ============================================================== -->
      <!-- Start Navigation -->
      <%- include('navbar') %>
      <!-- End Navigation -->
      <div class="clearfix"></div>
      <!-- ============================================================== -->
      <!-- Top header  -->
      <!-- ============================================================== -->

      <!-- ============================ Login Form Start ================================== -->
      <section class="gray-simple">
        <div class="container">
          <!-- row Start -->
          <div class="row justify-content-center">
            <!-- Single blog Grid -->
            <div class="col-xl-7 col-lg-8 col-md-12">
              <div class="card rounded-4 bg-transparent">
                <div class="card-body p-4">
                  <div
                    id="section-wrapper"
                    class="position-relative"
                    style="min-height: 600px">
                    <!-- ==== Radio Buttons Start ==== -->
                    <div
                      id="role-select-box"
                      style="
                        background-color: white;
                        padding: 10px 10px 20px 25px;
                        border-radius: 10px;
                      ">
                      <!--  radio buttons heading -->
                      <div class="form-heads d-block mb-2">
                        <div
                          class="d-flex align-items-center justify-content-start gap-3">
                          <div class="head-caps">
                            <h4>How do we recognize you?</h4>
                          </div>
                        </div>
                      </div>
                      <!--  radio buttons -->
                      <div class="form-group mb-0">
                        <div class="row g-4">
                          <div class="col-sm-6">
                            <div class="sing-btn-groups">
                              <input
                                type="radio"
                                class="btn-check"
                                name="role"
                                value="employer"
                                id="findtalent" />
                              <label
                                class="btn btn-md btn-outline-gray h-auto"
                                for="findtalent">
                                <div class="d-flex align-items-center gap-3">
                                  <div class="icons">
                                    <svg
                                      width="44"
                                      height="44"
                                      viewBox="0 0 24 24"
                                      fill="none"
                                      xmlns="http://www.w3.org/2000/svg">
                                      <path
                                        opacity="0.3"
                                        d="M20 15H4C2.9 15 2 14.1 2 13V7C2 6.4 2.4 6 3 6H21C21.6 6 22 6.4 22 7V13C22 14.1 21.1 15 20 15ZM13 12H11C10.5 12 10 12.4 10 13V16C10 16.5 10.4 17 11 17H13C13.6 17 14 16.6 14 16V13C14 12.4 13.6 12 13 12Z"
                                        fill="#ff3d00" />
                                      <path
                                        d="M14 6V5H10V6H8V5C8 3.9 8.9 3 10 3H14C15.1 3 16 3.9 16 5V6H14ZM20 15H14V16C14 16.6 13.5 17 13 17H11C10.5 17 10 16.6 10 16V15H4C3.6 15 3.3 14.9 3 14.7V18C3 19.1 3.9 20 5 20H19C20.1 20 21 19.1 21 18V14.7C20.7 14.9 20.4 15 20 15Z"
                                        fill="#ff3d00" />
                                    </svg>
                                  </div>
                                  <div class="btn-caps text-start">
                                    <h6 class="mb-0 lh-base">
                                      I'am an
                                      <span
                                        style="
                                          font-weight: 800;
                                          color: #ff3d00;
                                          text-transform: uppercase;
                                        "
                                        >Employer</span
                                      >
                                    </h6>
                                  </div>
                                </div>
                              </label>
                            </div>
                          </div>
                          <div class="col-sm-6">
                            <div class="sing-btn-groups">
                              <input
                                type="radio"
                                class="btn-check"
                                name="role"
                                value="candidate"
                                id="findjob" />
                              <label
                                class="btn btn-md btn-outline-gray h-auto"
                                for="findjob">
                                <div class="d-flex align-items-center gap-3">
                                  <div class="icons">
                                    <svg
                                      width="44"
                                      height="44"
                                      viewBox="0 0 24 24"
                                      fill="none"
                                      xmlns="http://www.w3.org/2000/svg">
                                      <path
                                        opacity="0.3"
                                        d="M22 12C22 17.5 17.5 22 12 22C6.5 22 2 17.5 2 12C2 6.5 6.5 2 12 2C17.5 2 22 6.5 22 12ZM12 7C10.3 7 9 8.3 9 10C9 11.7 10.3 13 12 13C13.7 13 15 11.7 15 10C15 8.3 13.7 7 12 7Z"
                                        fill="#ff3d00" />
                                      <path
                                        d="M12 22C14.6 22 17 21 18.7 19.4C17.9 16.9 15.2 15 12 15C8.8 15 6.09999 16.9 5.29999 19.4C6.99999 21 9.4 22 12 22Z"
                                        fill="#ff3d00" />
                                    </svg>
                                  </div>
                                  <div class="btn-caps text-start">
                                    <h6 class="mb-0 lh-base">
                                      I'am a
                                      <span
                                        style="
                                          font-weight: 800;
                                          color: #ff3d00;
                                          text-transform: uppercase;
                                        "
                                        >Candidate</span
                                      >
                                    </h6>
                                  </div>
                                </div>
                              </label>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- ==== Radio Buttons End ==== -->
                    <!-- ==== Employer Register Form Start ==== -->
                    <form
                      id="employer_form"
                      method="post"
                      action="/employer-dashboard"
                      class="p-md-4">
                      <div
                        id="form-employer"
                        class="form-fade"
                        style="
