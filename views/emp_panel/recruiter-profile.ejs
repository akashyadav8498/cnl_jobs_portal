                  <img
                    src="assets/img/verify-email-icon.svg"
                    class="img-fluid mx-auto"
                    width="140"
                    alt="Image" />
                </div>

                <div class="message-wrap text-center d-block mb-4">
                  <h4 class="mb-4">Verify your email address</h4>
                  <h6 class="fw-normal">
                    You've entered themezhub@gmail.com as the email address for
                    your account.
                  </h6>
                  <p>
                    Please verify this email adress by clicking button bellow
