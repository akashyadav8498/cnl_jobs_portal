    <script>
      const percent = 85; // Set your percentage here (0 to 100)
      const circle = document.querySelector(".progress");
      const radius = 60;
      const circumference = 2 * Math.PI * radius;
      const offset = circumference - (percent / 100) * circumference;
      circle.style.strokeDasharray = `${circumference}`;
      circle.style.strokeDashoffset = offset;
    </script>
    <script>
      function moveToNext(currentInput) {
        if (currentInput.value.length === 1) {
          const nextInput = currentInput.nextElementSibling;
          if (nextInput !== null) {
            nextInput.focus();
          }
        }
      }

      function getUsers() {
        fetch("/api/user/getUserDetails")
          .then((res) => res.json())
          .then((data) => {
            const userDetails = data.userDetails.hrProfile;
            $("#hrName").text(userDetails.u_name);
            $("#name").val(userDetails.u_name);
            $("#designation").val(userDetails.designation);
            $("#experience").val(userDetails.experience);
            $("#contact").val(userDetails.contact);
            $("#email").val(data.userDetails.email);
            $("#description").val(userDetails.description);
          })
          .catch((err) => console.error(err));
      }

      window.onload = function () {
        getUsers();
      };

      document
        .getElementById("update_details")
        .addEventListener("submit", function (e) {
          e.preventDefault();

          const form = e.target;
          const formData = new FormData(form);

          fetch("/api/user/updateUser", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(formData.entries())),
          })
            .then((res) => res.json())
            .then((response) => {
              if (response.success == true) {
                $("#successMessage").text(response.message);
                $("#successmodal").modal("show");
                getUsers();
              } else {
                $("#errorMessage").text(response.message);
                $("#errorMessage").css("display", "block");
              }
            });
        });
    </script>
  </body>
</html>
