            <!-- Card Row -->
            <form id="update_details">
              <div class="card">
                <div class="card-header">
                  <h4>Update Details</h4>
                </div>
                <div class="card-body">
                  <div class="row">
                    <!-- Name -->
                    <div class="col-xl-6 col-lg-6 col-md-12">
                      <div class="form-group">
                        <label>Name</label>
                        <input
                          type="text"
                          id="name"
                          name="name"
                          class="form-control" />
                      </div>
                    </div>

                    <!-- Designation -->
                    <div class="col-xl-6 col-lg-6 col-md-12">
                      <div class="form-group">
                        <label>Designation</label>
                        <input
                          type="text"
                          id="designation"
                          name="designation"
                          class="form-control" />
                      </div>
                    </div>

                    <!-- Contact -->
                    <div class="col-xl-6 col-lg-6 col-md-12">
                      <div class="form-group">
                        <label>Contact No.</label>
                        <input
                          type="text"
                          id="contact"
                          name="contact"
                          class="form-control" />
                      </div>
                    </div>
                    <!-- Email -->
                    <div class="col-xl-6 col-lg-6 col-md-12">
                      <div class="form-group">
                        <label>Email</label>
                        <input
                          type="text"
                          id="email"
                          name="email"
                          class="form-control" />
                      </div>
                    </div>

                    <div class="col-xl-12 col-lg-12 col-md-12">
                      <div class="form-group">
                        <label>About Yourself</label>
                        <textarea
                          id="description"
                          name="description"
                          class="form-control ht-80"
                          placeholder="Provide a short summary of your professional identity, career journey, core competencies, and your approach to work. Highlight anything that represents you well. (Limit: 1000 characters)
"></textarea>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Card Row End -->
              <!-- Submit Busston -->
              <div style="display: flex; align-items: center; gap: 12px">
