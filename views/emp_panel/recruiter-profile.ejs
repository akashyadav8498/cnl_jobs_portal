                      maxlength="1"
                      oninput="moveToNext(this)"
                      placeholder="-" />
                    <input
                      type="text"
                      class="form-control fs-6 text-center"
                      maxlength="1"
                      oninput="moveToNext(this)"
                      placeholder="-" />
                    <input
                      type="text"
                      class="form-control fs-6 text-center"
                      maxlength="1"
                      oninput="moveToNext(this)"
                      placeholder="-" />
                    <input
                      type="text"
                      class="form-control fs-6 text-center"
                      maxlength="1"
                      oninput="moveToNext(this)"
                      placeholder="-" />
                    <input
