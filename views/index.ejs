    <!--============================ Splide Slider ===============================-->
    <!-- CSS & JS Links -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4/dist/css/splide.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4/dist/js/splide.min.js"></script>
    <script>
      /* ===========================================================
   Hire Talents & Experts → Convert Grid into Splide Slider
   =========================================================== */

      document.addEventListener("DOMContentLoaded", function () {
        /* ---------------------------------------------------------
     1) Identify the grid row that contains all candidate cards
     --------------------------------------------------------- */
        var gridRow = document.querySelector(
          ".gray-simple .container > .row + .row.justify-content-center.gx-4.gy-4"
        );
        if (!gridRow) return;

        /* ---------------------------------------------------------
     2) Create Splide structure dynamically
     --------------------------------------------------------- */
        var splideRoot = document.createElement("div");
        splideRoot.className = "splide splide-hire-experts";
        splideRoot.style.position = "relative";
        splideRoot.style.overflow = "visible"; // ensure arrows clickable

        var track = document.createElement("div");
        track.className = "splide__track";

        var list = document.createElement("ul");
        list.className = "splide__list";

        // Move each Bootstrap column → Splide slide
        var cols = Array.from(gridRow.children);
        cols.forEach(function (col) {
          var li = document.createElement("li");
          li.className = "splide__slide";

          // Clean bootstrap classes so Splide controls width
          col.className = col.className.replace(/\bcol-[^\s]+\b/g, "").trim();

          li.innerHTML = col.outerHTML;
          list.appendChild(li);
        });

        // append track + list
        track.appendChild(list);
        splideRoot.appendChild(track);

        /* ---------------------------------------------------------
     3) Create custom NEXT / PREV buttons
     --------------------------------------------------------- */
        var prevBtn = document.createElement("button");
        prevBtn.className = "splide-hire-prev";
        prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';

        var nextBtn = document.createElement("button");
        nextBtn.className = "splide-hire-next";
        nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';

        // append buttons
        splideRoot.appendChild(prevBtn);
        splideRoot.appendChild(nextBtn);

        /* ---------------------------------------------------------
     4) Replace the old grid with Splide slider
     --------------------------------------------------------- */
        gridRow.insertAdjacentElement("beforebegin", splideRoot);
        gridRow.remove();

        /* ---------------------------------------------------------
     5) Add CSS styling for arrows + spacing
     --------------------------------------------------------- */
        var style = document.createElement("style");
        style.innerHTML = `
    .splide-hire-experts .splide__slide { padding: 0 12px; }
    .splide-hire-experts .splide-hire-prev,
    .splide-hire-experts .splide-hire-next {
      position: absolute;
      top: 45%;
      transform: translateY(-50%);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid #eee;
      background: white;
      color: #ff3d00;
      font-size: 18px;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      z-index: 9999;
      box-shadow: 0 1px 2px rgba(0,0,0,0.15);
      transition: 0.25s;
    }
    .splide-hire-experts .splide-hire-prev:hover,
    .splide-hire-experts .splide-hire-next:hover {
      background: #ff3d00;
      color: #fff;
      transform: translateY(-50%) scale(1.1);
    }
    .splide-hire-experts .splide-hire-prev { left: -20px; }
    .splide-hire-experts .splide-hire-next { right: -20px; }
  `;
        document.head.appendChild(style);

        /* ---------------------------------------------------------
     6) Initialize Splide
     --------------------------------------------------------- */
        var splide = new Splide(".splide-hire-experts", {
          perPage: 4,
          perMove: 1,
          gap: "24px",
          pagination: false,
          arrows: false,
          speed: 1400,
          easing: "cubic-bezier(.15,.85,.25,1)",

          type: "loop",
          autoplay: true,
          interval: 2800,
          pauseOnHover: false,
          pauseOnFocus: false,

          drag: true,
          flickPower: 120,
          flickVelocityThreshold: 0.25,
          keyboard: "global",

          wheel: false, // custom scroll added below

          breakpoints: {
            1200: { perPage: 3 },
            992: { perPage: 2 },
            576: { perPage: 1 },
          },
        });

        splide.mount();

        /* ---------------------------------------------------------
     7) Fix arrows NOT clickable — bind correctly to THIS slider
     --------------------------------------------------------- */
        var prev = document.querySelector(
          ".splide-hire-experts .splide-hire-prev"
        );
        var next = document.querySelector(
          ".splide-hire-experts .splide-hire-next"
        );

        if (prev)
          prev.addEventListener("click", function (e) {
            e.stopPropagation();
            splide.go("<");
          });

        if (next)
          next.addEventListener("click", function (e) {
            e.stopPropagation();
            splide.go(">");
          });

        /* ---------------------------------------------------------
     8) Custom mouse-wheel scroll (same as job slider)
     --------------------------------------------------------- */
        (function addSmartWheelScroll() {
          var el = document.querySelector(".splide-hire-experts");
          if (!el) return;

          var lastWheel = 0;
          var wheelDelay = 220;
          var acc = 0;
          var accThreshold = 40;

          function getPerPage() {
            return typeof splide.options.perPage === "number"
              ? splide.options.perPage
              : 1;
          }

          el.addEventListener(
            "wheel",
            function (evt) {
              if (Math.abs(evt.deltaY) < Math.abs(evt.deltaX)) return;
              if (evt.ctrlKey || evt.altKey || evt.metaKey) return;

              var now = Date.now();
              var delta = evt.deltaY;

              if (Math.abs(delta) < 20) {
                acc += delta;
                if (Math.abs(acc) < accThreshold) return;
                delta = acc;
                acc = 0;
              } else {
                acc = 0;
              }

              var perPage = getPerPage();
              var maxIndex = Math.max(0, splide.length - perPage);
              var idx = splide.index;

              if (delta < 0 && idx === 0) return;
              if (delta > 0 && idx >= maxIndex) return;

              evt.preventDefault();
              if (now - lastWheel < wheelDelay) return;
              lastWheel = now;

              if (delta > 0) splide.go(">");
              else splide.go("<");
            },
            { passive: false }
          );
        })();
      });
    </script>

    <style>
      /* === Custom CSS Featured Jobs === */
      /* --- Arrow Buttons --- */
      .splide-custom-prev,
      .splide-custom-next {
        position: absolute;
        top: 45%;
        transform: translateY(-50%);
        z-index: 10;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid #eee;
        background: white;
        color: #ff3d00;
        font-size: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.2);
        transition: 0.25s ease;
      }
      .splide-custom-prev:hover,
      .splide-custom-next:hover {
        background: #ff3d00;
        color: #fff;
        transform: translateY(-50%) scale(1.08);
      }
      .splide-custom-prev {
        left: -20px;
      }
      .splide-custom-next {
        right: -20px;
      }
      /* --- Ensure slide content doesn't shrink --- */
      .splide__slide {
        height: auto;
      }

      /* === Custom CSS Explore Categories === */

      /* --- Enable marquee mode --- */
      .marquee-mode .splide__list {
        display: flex;
        animation: marqueeScroll 8s linear infinite;
      }
      /* Pause on hover */
      .marquee-mode:hover .splide__list {
        animation-play-state: paused;
      }
      /* Duplicate slides automatically (visually) */
      .marquee-mode .splide__slide {
        flex: 0 0 auto;
      }
      /* Smooth continuous movement */
      @keyframes marqueeScroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
        }
      }
    </style>
