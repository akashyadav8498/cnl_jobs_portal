  <!-- ======================== Splide Slider Script ================== -->
  <script>
    /* ===== Script for Featured Jobs ===== */

    document.addEventListener("DOMContentLoaded", function () {
      var splide = new Splide("#jobSplide", {
        perPage: 4,
        perMove: 1,
        gap: "24px",
        pagination: false,
        arrows: false,

        /* --- SUPER SMOOTH SLIDE MOTION --- */
        speed: 1400,
        easing: "cubic-bezier(.15, .85, .25, 1)",

        drag: true,
        flickPower: 120,
        flickVelocityThreshold: 0.25,
        keyboard: "global",

        /* --- AUTOPLAY --- */
        type: "loop",
        autoplay: true,
        interval: 2800,
        pauseOnHover: false,
        pauseOnFocus: false,

        /* Disable Splide's built-in wheel handler — we'll use a custom one. */
        wheel: false,

        breakpoints: {
          1200: { perPage: 3 },
          992: { perPage: 2 },
          576: { perPage: 1 },
        },
      });

      splide.mount();

      // custom wheel handling so page scrolls when slider is at ends
      (function addSmartWheelScroll() {
        var el = document.querySelector("#jobSplide");
        if (!el) return;

        var lastWheel = 0;
        var wheelDelay = 220; // ms debounce between slide moves (tweak for sensitivity)
        var acc = 0; // accumulator for small touchpad deltas
        var accThreshold = 40; // how much aggregated delta triggers a slide (tweak if too sensitive)

        // helper to get current perPage (responsive)
        function getPerPage() {
          // splide.options.perPage may be a number (or; Splide handles breakpoints internally),
          // but to be safe, use splide.options.perPage which updates on resize in Splide v4.
          return typeof splide.options.perPage === "number"
            ? splide.options.perPage
            : 1;
        }

        el.addEventListener(
          "wheel",
          function (evt) {
            // only handle vertical wheel
            if (Math.abs(evt.deltaY) < Math.abs(evt.deltaX)) return;

            // allow the browser to handle when ctrl/alt/meta pressed (user intent)
            if (evt.ctrlKey || evt.altKey || evt.metaKey) return;

            var now = Date.now();
            var delta = evt.deltaY;

            // if small delta (like gentle touchpad) accumulate before acting
            if (Math.abs(delta) < 20) {
              acc += delta;
              // only act when accumulated passes threshold
              if (Math.abs(acc) < accThreshold) {
                // don't prevent default yet — allow small movement to scroll page if at ends
                return;
              }
              // we've reached threshold — convert to one big delta and reset accumulator
              delta = acc;
              acc = 0;
            } else {
              // large delta (mouse wheel) -> reset accumulator
              acc = 0;
            }

            // determine slider boundaries
            var perPage = getPerPage();
            var maxIndex = Math.max(0, splide.length - perPage);
            var idx = splide.index;

            // If user is trying to scroll UP and slider is at first slide -> allow page to scroll
            if (delta < 0 && idx === 0) {
              // do not preventDefault, let page scroll
              return;
            }

            // If user is trying to scroll DOWN and slider is at last slide -> allow page to scroll
            if (delta > 0 && idx >= maxIndex) {
              return;
            }

            // Otherwise we want the wheel to control the slider: prevent page scroll
            evt.preventDefault();

            // simple debounce so we don't trigger too many splide.go calls for continuous wheel
            if (now - lastWheel < wheelDelay) return;
            lastWheel = now;

            if (delta > 0) {
              splide.go(">");
            } else {
              splide.go("<");
            }
          },
          { passive: false } // we call preventDefault, so must be non-passive
        );
      })();

      // custom arrows
      var prev = document.querySelector(".splide-custom-prev");
      var next = document.querySelector(".splide-custom-next");
      if (prev) prev.addEventListener("click", () => splide.go("<"));
      if (next) next.addEventListener("click", () => splide.go(">"));
    });

    /* ===== Script for Explore Categories ===== */
    document.addEventListener("DOMContentLoaded", function () {
      const list = document.querySelector(
        "#categoryMarqueeSplide .splide__list"
      );
      list.innerHTML += list.innerHTML; // DUPLICATE SLIDES

      var splide = new Splide("#categoryMarqueeSplide", {
        type: "loop",
        perPage: 6,
        perMove: 1,
        gap: "16px",
        drag: true,
        arrows: false,
        pagination: false,
        breakpoints: {
          1200: { perPage: 5 },
          992: { perPage: 4 },
          768: { perPage: 3 },
          576: { perPage: 2 },
        },
      });

      splide.mount();
    });
  </script>
